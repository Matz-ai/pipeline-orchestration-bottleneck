# Copier en .env (ignoré par git) et remplir.

# Kestra
KESTRA_VERSION=v2.0.5
KESTRA_PORT=8080
KESTRA_UI_URL=http://localhost:8080
# Connexion à l'UI : e-mail (même fictif), mot de passe de 8 caractères min. avec 1 majuscule et 1 chiffre
KESTRA_BASIC_AUTH_USERNAME=
KESTRA_BASIC_AUTH_PASSWORD=

# Chemins vus depuis le conteneur (= ./data sur l'hôte)
DUCKDB_PATH=/bottleneck/data/warehouse.duckdb
DATA_RAW_DIR=/bottleneck/data/raw
DATA_OUTPUT_DIR=/bottleneck/data/outputs

# Seuil du z-score (vin millésime si z > seuil)
ZSCORE_THRESHOLD=2
SCHEDULE_TIMEZONE=Europe/Paris

# Nommage des livrables : Nom_Prenom_<n>_<nom>_<mmaaaa>
LIVRABLE_NOM=
LIVRABLE_PRENOM=
LIVRABLE_DATE=
